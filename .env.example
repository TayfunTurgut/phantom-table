# --- Claude Code backend ---
# All completions run through headless `claude -p` on your Claude subscription.
# Requires the Claude Code CLI installed and authenticated (interactive login,
# or a long-lived token from `claude setup-token`).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...   # from `claude setup-token`
# CLAUDE_CLI_PATH=claude
# LLM_TIMEOUT_SECONDS=900
# Transient `claude -p` failures (timeout, nonzero exit, bad envelope) are
# retried this many times total, with a linear backoff between attempts.
# LLM_RETRY_ATTEMPTS=3
# LLM_RETRY_BACKOFF_SECONDS=2.0

# Runtime decisions (one structured call per player decision).
CLAUDE_PLAYER_MODEL=sonnet
# One-time per-game generation (digest + engine + tests). Bump to opus for
# stronger codegen if your plan allows.
CLAUDE_DIGEST_MODEL=sonnet
CLAUDE_CODEGEN_MODEL=sonnet

# --- App ---
GAME_CONFIGS_DIR=game_configs
LOG_LEVEL=INFO

# --- Safety caps (defaults shown; crashing ceilings, not targets) ---
# MAX_STEPS=1000

# --- Ingestion budgets (defaults shown) ---
# INGEST_MAX_ENGINE_ATTEMPTS=4
# INGEST_MAX_TEST_REPAIRS=3
# INGEST_MAX_DIGEST_ATTEMPTS=2
# INGEST_GAMES_PER_COUNT=30
# INGEST_VALIDATION_TIMEOUT_SECONDS=600
