# --- LLM backend selection ---
# "openai": the OpenAI API (per-token billing; requires OPENAI_API_KEY)
# "claude_cli": headless `claude -p` on your Claude subscription (requires the
#               Claude Code CLI; auth via your login or CLAUDE_CODE_OAUTH_TOKEN
#               from `claude setup-token`)
LLM_BACKEND=openai
# "openai" or "local" (ChromaDB's built-in ONNX model — free and offline)
EMBEDDING_BACKEND=openai
# LLM_TIMEOUT_SECONDS=900

# --- OpenAI backend ---
OPENAI_API_KEY=sk-your-key-here
# Runtime decisions (one structured call per player decision) — cheap tier.
PLAYER_MODEL=gpt-5-mini
# One-time per-game generation (digest + engine + tests) — strong tier.
DIGEST_MODEL=gpt-5
CODEGEN_MODEL=gpt-5
EMBEDDING_MODEL=text-embedding-3-small

# --- Claude CLI backend ---
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...   # from `claude setup-token`
# CLAUDE_CLI_PATH=claude
CLAUDE_PLAYER_MODEL=sonnet
# Bump these to opus for stronger codegen if your plan allows.
CLAUDE_DIGEST_MODEL=sonnet
CLAUDE_CODEGEN_MODEL=sonnet

# --- App ---
GAME_CONFIGS_DIR=game_configs
LOG_LEVEL=INFO

# --- LangSmith (optional observability; traces the openai backend only) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=phantom-table

# --- Safety caps (defaults shown; crashing ceilings, not targets) ---
# MAX_STEPS=1000
# PLAYER_RULEBOOK_QUERIES=true
